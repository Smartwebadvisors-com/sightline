# Postgres. Sightline shares the trendsignal database.
SIGHTLINE_DB_URL=postgresql://trendsignal:CHANGEME@localhost/trendsignal

# Google PageSpeed Insights.
PAGESPEED_API_KEY=

# DataForSEO. Basic auth.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional: identify Sightline in outbound requests.
SIGHTLINE_USER_AGENT="Sightline-Diagnostic/0.1 (+contact: larry@smartwebadvisors.com)"
